#!/usr/bin/env ruby
# frozen_string_literal: true

# pty-tester — the side-by-side parity rig (BRIEF §2, frozen CLI surface).
#
#   pty-tester run <scenario.yml> [--runs N] [--app both|pi|tart]
#                  [--out <dir>] [--tart-dir <path>] [--pi-bin <path>]
#   pty-tester diff <capture-a> <capture-b> [--registry <file>]
#
# Exit codes: 0 = all difference lines sanctioned; 1 = unknown-candidate
# lines exist (listed); 2 = rig failure.
#
# Stdlib only — runs without Bundler.

require "optparse"

require_relative "../lib/tart/parity"

def run_verb(argv)
  options = {runs: 1, app: "both", out: nil, tart_dir: nil, pi_bin: nil}
  parser = OptionParser.new do |p|
    p.on("--runs N", Integer, "number of runs (default 1)") { |n| options[:runs] = n }
    p.on("--app NAME", %w[both pi tart], "which app(s): both|pi|tart (default both)") { |a| options[:app] = a }
    p.on("--out DIR", "output directory (default tmp/parity/<timestamp>)") { |d| options[:out] = d }
    p.on("--tart-dir PATH", "tart checkout to run (default: this repo)") { |d| options[:tart_dir] = d }
    p.on("--pi-bin PATH", "installed pi binary (default: command -v pi)") { |d| options[:pi_bin] = d }
  end
  parser.parse!(argv)
  scenario_path = argv.shift
  usage! if scenario_path.nil? || argv.shift

  scenario = Tart::Parity::Scenario.load(scenario_path)
  runner = Tart::Parity::Runner.new(
    scenario:, runs: options.fetch(:runs), app: options.fetch(:app),
    out: options[:out],
    tart_dir: options[:tart_dir],
    pi_bin: options[:pi_bin]
  )
  result = runner.run!
  warn "out dir: #{result.out_dir}"
  exit result.exit_code
rescue Tart::Parity::Error => e
  warn "pty-tester: #{e.message}"
  exit 2
rescue OptionParser::ParseError
  usage!
end

def diff_verb(argv)
  options = {registry: File.expand_path("../parity/registry.yml", __dir__)}
  parser = OptionParser.new do |p|
    p.on("--registry FILE", "difference registry (default parity/registry.yml)") { |f| options[:registry] = f }
  end
  parser.parse!(argv)
  a_path = argv.shift
  b_path = argv.shift
  usage! if a_path.nil? || b_path.nil? || argv.shift

  [a_path, b_path].each do |path|
    unless File.readable?(path)
      warn "pty-tester: #{path}: no such capture file"
      exit 2
    end
  end
  registry = Tart::Parity::Registry.load(options.fetch(:registry))
  differ = Tart::Parity::Differ.diff(File.read(a_path), File.read(b_path), registry)

  puts "--- #{a_path}"
  puts "+++ #{b_path}"
  puts
  puts differ.unified
  puts
  puts "== difference lines: #{differ.classifications.size} (sanctioned: #{differ.classifications.size - differ.candidates.size}, unknown-candidate: #{differ.candidates.size})"
  differ.classifications.each do |classified|
    sign = classified.op.kind == :del ? "-" : "+"
    verdict = classified.klass ? "sanctioned(#{classified.klass})" : "unknown-candidate"
    puts format("%s %s -> %s", sign, classified.op.line, verdict)
  end
  exit differ.clean? ? 0 : 1
rescue Tart::Parity::Error => e
  warn "pty-tester: #{e.message}"
  exit 2
rescue OptionParser::ParseError
  usage!
end

def usage!
  warn usage_line
  exit 2
end

def usage_line
  "usage: pty-tester run <scenario.yml> [--runs N] [--app both|pi|tart] [--out <dir>] [--tart-dir <path>] [--pi-bin <path>]\n" \
    "       pty-tester diff <capture-a> <capture-b> [--registry <file>]"
end

verb = ARGV.shift
case verb
when "run" then run_verb(ARGV)
when "diff" then diff_verb(ARGV)
else
  usage!
end
